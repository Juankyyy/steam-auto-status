{
  "name": "steam-auto-status",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "ui",
    "sidecar"
  ],
  "scripts": {
    "dev": "npm run build:sidecar && npm run fetch:runtime && tauri dev",
    "build": "npm run build:sidecar && npm run fetch:runtime && tauri build && npm run rename:installer",
    "build:sidecar": "npm run build --workspace sidecar",
    "build:ui": "npm run build --workspace ui",
    "fetch:runtime": "node scripts/fetch-node-runtime.mjs",
    "rename:installer": "node scripts/rename-installer.mjs",
    "set:version": "node scripts/set-version.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}

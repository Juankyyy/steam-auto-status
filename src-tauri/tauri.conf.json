{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Auto Status",
  "version": "0.2.2",
  "identifier": "com.juankyyy.steam-auto-status",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Steam Auto Status",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../sidecar/dist/sidecar.cjs": "sidecar/sidecar.cjs",
      "../sidecar/dist/system.pem": "sidecar/system.pem",
      "../node_modules/lzma/index.js": "sidecar/node_modules/lzma/index.js",
      "../node_modules/lzma/package.json": "sidecar/node_modules/lzma/package.json",
      "../node_modules/lzma/src/lzma_worker.js": "sidecar/node_modules/lzma/src/lzma_worker.js",
      "runtime/node.exe": "runtime/node.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
